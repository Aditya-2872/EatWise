# EatWise environment template — copy to .env.local and fill in.
# NEVER commit .env.local. Values shown here are placeholders only.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# Server-only. Needed for AI-created custom foods, USDA/OFF result caching,
# and account deletion. The app boots without it but those features error clearly.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (spec §26) ---
# "gemini" (default) or "mock" (deterministic fake responses for development)
AI_PROVIDER=gemini
# Server-only Gemini key. Required for AI_PROVIDER=gemini.
AI_API_KEY=
# Defaults to gemini-3.6-flash when unset.
AI_VISION_MODEL=
AI_LANGUAGE_MODEL=

# --- Food data providers (optional, spec §16) ---
# USDA FoodData Central API key (https://fdc.nal.usda.gov/api-key-signup)
FOOD_API_KEY=
# Contact email for Open Food Facts API etiquette
OFF_CONTACT_EMAIL=

# --- App ---
# Public origin used in emails/redirects. Defaults to http://localhost:3000
NEXT_PUBLIC_APP_URL=
